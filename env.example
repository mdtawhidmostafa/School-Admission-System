# Local development settings. Copy this file to .env and change the password.
POSTGRES_DB=admissions
POSTGRES_USER=admissions
POSTGRES_PASSWORD=change-this-to-a-strong-local-password

# assignment preserves the assignment's no-login workflow.
# protected requires ADMIN_API_KEY (at least 32 UTF-8 bytes) for POST /classes.
AUTH_MODE=assignment
ADMIN_API_KEY=

# Temporary seat hold duration (1 to 86400 seconds).
HOLD_DURATION_SECONDS=600

# Keep 0 except when running the expiry test in a separate disposable QA stack.
TEST_HOLD_SECONDS=0

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
